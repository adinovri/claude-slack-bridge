# ==========================================================================
# Slack (required)
# ==========================================================================

# Bot token (xoxb-...) — Slack app → OAuth & Permissions → Bot User OAuth Token.
# Used for every message the bridge posts. Keep it out of shell history and
# out of any file that is not mode 600.
SLACK_BOT_TOKEN=xoxb-...

# App-level token (xapp-...) — Slack app → Basic Information → App-Level Tokens.
# Scope: connections:write (Socket Mode). This is what opens the WebSocket, so
# the bridge needs no public URL and no inbound firewall rule.
SLACK_APP_TOKEN=xapp-...

# ==========================================================================
# Authorization (required) — read this before you fill it in
# ==========================================================================

# The Slack member ID of the ONE account allowed to drive this bridge.
# Find it: Slack profile → ⋮ → "Copy member ID". It is a capital U
# followed by 8-10 alphanumerics (written as Uxxx throughout these docs).
#
#   In a channel: the bot must be @-mentioned AND the author must be this ID.
#   In a DM:      any message from this ID triggers a run.
#   Everyone else is dropped silently, with no reply.
#
# This single check is the entire trust boundary. The agent it spawns runs with
# bypassPermissions — full shell, full filesystem, every MCP server configured
# for that account. Anyone who can post as this user can run commands on this
# host. Do not set it to a shared or bot account. See SECURITY.md.
TRIGGER_USER_ID=

# ==========================================================================
# Paths
# ==========================================================================

# REQUIRED. Working directory for the spawned `claude` CLI — it inherits the
# CLAUDE.md, MCP servers, and tooling of whatever tree you point it at. There
# is deliberately no default: pick this consciously.
AGENT_WORKSPACE=/path/to/agent-workspace

# Per-thread session storage (one small JSON file per Slack thread; stores
# thread_ts, channel, and the claude session id — no message text).
# Default: ~/.claude-slack-bridge/threads
# THREAD_STORE_DIR=

# Background-task registry, shared by the bridge, csb-bg-claude and
# csb-bg-watchdog. All three MUST agree on this path.
# Default: ~/.claude-slack-bridge/bg_registry.json
# BG_REGISTRY=

# ==========================================================================
# Claude runtime
# ==========================================================================

# Path to the claude CLI (https://docs.claude.com/en/docs/claude-code)
CLAUDE_CLI=claude

# Model for bridge-initiated runs
CLAUDE_MODEL=claude-sonnet-4-6

# Permission mode. bypassPermissions is what makes non-interactive runs useful
# (no approval prompt to answer), and is also why TRIGGER_USER_ID must be a
# single trusted human. Narrow it to "default" or "acceptEdits" if you would
# rather answer prompts than grant full tool access.
CLAUDE_PERMISSION_MODE=bypassPermissions

# Subprocess timeout per run (seconds)
CLAUDE_TIMEOUT=600

# How the agent refers to itself in the prompt preamble. Cosmetic.
# AGENT_NAME=Claude

# CLAUDE_CONFIG_DIR — where the claude CLI reads its OAuth credentials and
# writes session transcripts. Resolution order (first wins):
#   1. service unit  → Environment=CLAUDE_CONFIG_DIR=... in deploy/*
#   2. THIS .env     → uncomment below
#   3. shell env     → export before running
#   4. default       → ~/.claude
# If you run several agents under different accounts on one machine, pin this
# per-service in the unit rather than here.
# CLAUDE_CONFIG_DIR=

# ==========================================================================
# Optional — Telegram notify fallback for [bg] tasks
# ==========================================================================
# Only used when a bg task's notify target is "telegram". The bridge itself
# always notifies via Slack; these are for other callers of csb-bg /
# csb-notify.
#
# Prefer putting these in ~/.config/claude-slack-bridge.env (mode 600) rather
# than here, so they are not baked into the bridge's own .env. The watchdog
# unit reads that file via EnvironmentFile=-.
#
# TELEGRAM_BOT_TOKEN=123456:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TELEGRAM_CHAT_ID=1234567890

# ==========================================================================
# Misc
# ==========================================================================

# Orphan tmux reaper: comma-separated "match_prefix:skip_prefix" pairs.
# Default: csb-:csb-bg-   (only touches sessions this bridge created)
# CSB_ORPHAN_PATTERNS=

LOG_LEVEL=INFO
