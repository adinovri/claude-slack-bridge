#!/usr/bin/env bash
# csb-notify — Send a Telegram notification (used by csb-bg-watchdog for
# the default "telegram" notify target).
#
# Usage: csb-notify <message>
# Message supports Telegram Markdown (*bold*, `code`, ```block```).
#
# Reads secrets from the environment (NEVER hardcode them here):
#   TELEGRAM_BOT_TOKEN   Telegram bot token from @BotFather
#   TELEGRAM_CHAT_ID     Chat ID to send to
#
# If either is unset, they are sourced from $CSB_ENV_FILE (default
# ~/.config/claude-slack-bridge.env, mode 600). Callers that are not launched
# from a systemd unit — a bg Claude session, an ad-hoc helper, an interactive
# shell — have no EnvironmentFile to inherit from, so without this fallback
# they would silently stop notifying.
#
# Exits 0 with a warning if the secrets are still missing — the caller
# (csb-bg-watchdog) treats notify failures as non-fatal, so an unconfigured
# Telegram target should NOT crash the watchdog.
set -euo pipefail

if [ $# -lt 1 ] || [ -z "${1:-}" ]; then
  echo "Usage: csb-notify <message>" >&2
  exit 1
fi

ENV_FILE="${CSB_ENV_FILE:-$HOME/.config/claude-slack-bridge.env}"
if [ -z "${TELEGRAM_BOT_TOKEN:-}" ] || [ -z "${TELEGRAM_CHAT_ID:-}" ]; then
  if [ -f "$ENV_FILE" ]; then
    set -a
    # shellcheck disable=SC1090
    . "$ENV_FILE"
    set +a
  fi
fi

if [ -z "${TELEGRAM_BOT_TOKEN:-}" ] || [ -z "${TELEGRAM_CHAT_ID:-}" ]; then
  logger -t csb-notify "skip: TELEGRAM_BOT_TOKEN or TELEGRAM_CHAT_ID unset and not found in $ENV_FILE (Telegram notify disabled)"
  exit 0
fi

curl -sS -X POST "https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/sendMessage" \
  -d "chat_id=${TELEGRAM_CHAT_ID}" \
  -d "parse_mode=Markdown" \
  --data-urlencode "text=$1" \
  > /dev/null
